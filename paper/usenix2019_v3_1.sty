% usenix2019_v3_1.sty - USENIX formatting for conference proceedings
% Based on the official USENIX template.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{usenix2019_v3_1}[2019/01/01 USENIX conference style]

% Page layout: US Letter, two-column
\RequirePackage[letterpaper,
  left=1in,right=1in,top=1in,bottom=1in,
  columnsep=0.33in]{geometry}

% Font: Times
\RequirePackage{mathptmx}
\RequirePackage[scaled=0.92]{helvet}
\RequirePackage{courier}

% Section formatting
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}

\titlespacing*{\section}{0pt}{12pt plus 2pt minus 2pt}{6pt plus 1pt minus 1pt}
\titlespacing*{\subsection}{0pt}{8pt plus 2pt minus 2pt}{4pt plus 1pt minus 1pt}
\titlespacing*{\subsubsection}{0pt}{6pt plus 2pt minus 1pt}{2pt plus 1pt minus 1pt}

% Paragraph spacing
\setlength{\parindent}{0.25in}
\setlength{\parskip}{0pt}

% Caption formatting
\RequirePackage[font=small,labelfont=bf]{caption}

% Abstract formatting
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}\small
}{%
  \end{quote}%
}

% Title formatting
\renewcommand{\maketitle}{%
  \twocolumn[%
    \begin{center}%
      {\Large\bfseries\@title\par}%
      \vskip 1.5em%
      {\large\@author\par}%
      \vskip 1em%
    \end{center}%
  ]%
}

% Footnote formatting
\renewcommand{\footnoterule}{%
  \kern-3pt%
  \hrule width 2in height 0.4pt%
  \kern 2.6pt%
}

% Page numbering
\pagestyle{plain}
